{
    "compilerOptions": {
        "checkJs": true,
        "maxNodeModuleJsDepth": 0,
        "skipLibCheck": true,
        "allowJs": true,
        "noEmit": true,
        "strict": false,
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": ["src/**/*.js"]
}
