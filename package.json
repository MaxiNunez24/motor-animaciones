{
    "name": "motor-animaciones",
    "version": "0.12.0",
    "description": "Motor de animaciones web deterministas: escenas declarativas, controles, y una capa para explicar conceptos.",
    "type": "module",
    "license": "MIT",
    "author": "Maximiliano Núñez",
    "homepage": "https://maxinunez24.github.io/motor-animaciones/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MaxiNunez24/motor-animaciones.git"
    },
    "main": "./dist/motor.js",
    "module": "./dist/motor.js",
    "exports": {
        ".": "./dist/motor.js",
        "./nucleo": "./src/nucleo/index.js",
        "./motor.min.js": "./dist/motor.min.js",
        "./motor-base.min.js": "./dist/motor-base.min.js",
        "./3d": "./dist/motor-3d.js",
        "./motor-3d.min.js": "./dist/motor-3d.min.js",
        "./mate": "./dist/motor-mate.js",
        "./motor-mate.min.js": "./dist/motor-mate.min.js",
        "./redes": "./dist/motor-redes.js",
        "./motor-redes.min.js": "./dist/motor-redes.min.js",
        "./finanzas": "./dist/motor-finanzas.js",
        "./motor-finanzas.min.js": "./dist/motor-finanzas.min.js"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "construir": "node herramientas/construir.js",
        "servir": "node herramientas/servir.js",
        "test": "node --test \"tests/nucleo/*.test.js\" \"tests/herramientas/*.test.js\"",
        "video": "node herramientas/video.js",
        "test:navegador": "node herramientas/construir.js && playwright test",
        "tipos": "tsc -p jsconfig.json",
        "revisar": "node herramientas/revisar.js"
    },
    "devDependencies": {
        "@playwright/test": "1.62.0",
        "esbuild": "0.28.2",
        "ffmpeg-static": "5.3.0",
        "three": "0.186.1",
        "typescript": "5.9.3"
    }
}
